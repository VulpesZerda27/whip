index 0000000..ab7b035
--- /dev/null
+++ b/node_modules/braces/lib/check-depth.js
@@ -0,0 +1,13 @@
+'use strict';
+
+// Bound recursive AST walkers until an upstream security release is available.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128) throw new SyntaxError('Brace nesting exceeds security limit (128)');
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
