{
  "expo": {
    "name": "Reins",
    "slug": "herdr-remote",
    "icon": "./assets/icon.png",
    "scheme": "whip",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Reins to scan server pairing codes and attach photos to chats.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Reins to scan server pairing codes and attach photos to chats.",
          "photosPermission": "Allow Reins to attach selected photos to chats."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "zh-Hant",
            "fr"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Reins to use Face ID to protect SSH keys and app access."
        }
      ],
      "expo-video",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "io.github.kaminarios.whip",
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSBonjourServices": [
          "_expo._tcp"
        ],
        "NSFaceIDUsageDescription": "Allow Reins to use Face ID to protect SSH keys and app access.",
        "NSLocalNetworkUsageDescription": "Reins connects to SSH servers on your local network.",
        "NSPhotoLibraryUsageDescription": "Allow Reins to attach selected photos to chats.",
        "NSMotionUsageDescription": "Allow Reins to silence persistent agent alerts when you shake your phone."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_NETWORK_STATE"
      ],
      "allowBackup": true,
      "package": "io.github.vulpeszerda27.whipchat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/reins/android-foreground.png",
        "backgroundColor": "#151B28",
        "monochromeImage": "./assets/reins/android-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "abffa698-56c9-41c1-9b61-3312006a895d"
      }
    },
    "owner": "kant64"
  }
}
